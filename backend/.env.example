# ================= 企业资料管理系统 环境配置模板 =================
# 用法：复制本文件为 backend/.env，按需修改后启动。
# 未配置的项使用内置默认值。配置优先级：显式环境变量 > .env > 默认值。
# 配置加载：app/config.py（pydantic-settings）。

# ---------- 应用 ----------
# APP_NAME=企业资料管理系统      # 应用名称
# DEBUG=false                    # 调试模式

# ---------- 数据库 ----------
# 默认 SQLite（data/app.db，db.py 自动启用 WAL + busy_timeout）；生产可切 PostgreSQL
# DATABASE_URL=sqlite:///./data/app.db

# ---------- JWT ----------
# SECRET_KEY=                    # JWT 签名密钥；缺省每次启动随机生成（重启后旧 token 失效），生产请固定
# JWT_EXPIRE_MINUTES=720         # Token 有效期（分钟），默认 12h

# ---------- 上传 ----------
# UPLOAD_DIR=./data/uploads      # 文件私有存储目录（仅经鉴权 API 访问，不暴露静态路径）
# MAX_UPLOAD_MB=200              # 单文件上传大小上限（MB）

# ---------- 向量库（M3） ----------
# CHROMA_DIR=./data/chroma       # Chroma 向量库持久化目录

# ---------- 爬虫定时调度（M5） ----------
# ENABLE_SCHEDULER=false         # 是否启动 APScheduler 按 cron 执行爬虫；false 时手动 run 仍可用

# ---------- admin 初始账号 ----------
# 首次启动自动播种内置 admin；缺省随机生成并打印到启动日志（仅首次播种生效）。
# ADMIN_INITIAL_PASSWORD=admin123

# ---------- 可选 Redis（未配置则降级为内存 TTL 热点搜索缓存） ----------
# REDIS_URL=redis://localhost:6379/0

# ---------- LLM（M4 问答） ----------
# LLM_MODE=local                 # local=Ollama / api=OpenAI 兼容
# LLM_MODEL=qwen2.5              # 模型名
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama /v1 兼容端点；api 模式填网关地址
# LLM_API_KEY=                   # api 模式密钥

# ---------- Embedding（M3 向量化） ----------
# EMBEDDING_MODE=local           # local=sentence-transformers / api=OpenAI 兼容
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5   # 本地模型（首次运行自动下载 ~100MB）
# EMBEDDING_DIM=512              # 向量维度，必须与向量库现有维度一致；切换维度需全量重建向量索引
# EMBEDDING_API_BASE_URL=        # api 模式地址；留空回退 LLM_BASE_URL
# EMBEDDING_API_KEY=             # api 模式密钥
# EMBEDDING_API_MODEL=           # api 模式模型名（如 text-embedding-3-small，注意维度）

# ---------- Reranker（M4 重排） ----------
# RERANKER_MODEL=BAAI/bge-reranker-base    # CrossEncoder 重排模型（首次运行自动下载 ~1.1GB）
# RERANKER_ENABLED=true          # 关闭则 RRF 融合后直接取 top5（可省模型下载）

# ---------- 检索阈值 ----------
# SEARCH_THRESHOLD=0.5           # 语义相似度阈值：最高分低于阈值视为"未找到相关内容"
# RERANK_THRESHOLD=0.55          # 重排分数下限：低于视为不相关剔除（sigmoid 中性基准 0.5）；关键词强相关文档豁免
