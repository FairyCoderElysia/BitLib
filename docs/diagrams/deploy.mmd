%% 部署拓扑图：私有化部署，局域网客户端 → 内网服务器（nginx + FastAPI + data 卷）
flowchart LR
    subgraph LAN["企业局域网（数据不出内网）"]
        C1["客户端电脑 A<br/>浏览器"]
        C2["客户端电脑 B<br/>浏览器"]
        C3["客户端电脑 C<br/>浏览器"]
    end

    subgraph SRV["内网服务器（单机私有化）"]
        direction TB
        N["Nginx :80/443<br/>静态 dist/ + /api 反代"]
        F["FastAPI 后端 :8000<br/>uvicorn"]
        subgraph DATA["data/ 卷（备份对象）"]
            DB[("app.db<br/>SQLite + FTS5")]
            UP["uploads/<br/>私有文件"]
            CHROMA[("chroma/<br/>向量库")]
        end
        RD[("Redis :6379<br/>可选热点缓存")]
        OLL["Ollama :11434<br/>本地 LLM/Embedding 模型<br/>(可选)"]
    end

    C1 -->|"HTTP :80"| N
    C2 -->|"HTTP :80"| N
    C3 -->|"HTTP :80"| N
    N -->|"/api"| F
    F --> DATA
    F -. 可选 .-> RD
    F -. 可选 .-> OLL
    OLL -. 可选 · 需联网下载模型 .-> INTERNET["模型源<br/>HuggingFace / Ollama Hub"]
    DATA -. "备份 backup.py → zip" .-> BAK["backup/ 目录<br/>异地/网盘同步"]

    classDef opt stroke-dasharray: 5 5
    class RD,OLL,INTERNET opt
